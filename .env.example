# Local runtime defaults. Production must set RUNTIME_PROFILE to platform or standalone.
NODE_ENV=development
RUNTIME_PROFILE=local
BODY_SIZE_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_EXPENSIVE_MAX_REQUESTS=30
# Required for RUNTIME_PROFILE=standalone in production.
OIDC_PROVIDER=Auth0
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_USER_ID_CLAIM=sub
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_TIMEOUT_MS=3000
OIDC_REDIRECT_URI=https://write.yingrenji.cn/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://write.yingrenji.cn/login

# Logger
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Standalone production requires an explicit PostgreSQL URL and absolute private storage root.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Added through the controlled normal-future backup credential bootstrap; not
# part of the initial-compromise rotation contract.
BACKUP_DATABASE_URL=
DOCUMENT_STORAGE_ROOT=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_PREMIUM_MODEL=deepseek-v4-pro
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=10000
ACADEMIC_SEARCH_CURSOR_SECRET=
ZOTERO_API_BASE_URL=https://api.zotero.org
ZOTERO_CREDENTIAL_ENCRYPTION_KEY=
ZOTERO_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
